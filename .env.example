#### Environment variables for Dockerfile
#### To apply the settings, need to copy this file to .env and build the container

# Container project name
COMPOSE_PROJECT_NAME = cdim

# Port forward setting (host side port number)
PORT_CORE      = 3000
PORT_RESOURCE  = 3003
PORT_LAYOUT    = 3004
PORT_USER      = 3005

## Git user settings
## The Dev Containers extension automatically copies the .gitconfig file to the container, so it is basically unnecessary
# GIT_COMMITTER_NAME = 'Xxx Xxxx'
# GIT_COMMITTER_EMAIL = 'xxx@xxx.com'
# GIT_AUTHOR_NAME = 'Xxx Xxxx'
# GIT_AUTHOR_EMAIL = 'xxx@xxx.com'

## Proxy settings (unnecessary if set in host environment variables)
# HTTP_PROXY = 'http://xxx'
# http_proxy = 'http://xxx'
# HTTPS_PROXY = 'http://xxx'
# https_proxy = 'http://xxx'
# NO_PROXY = 'http://xxx'
# no_proxy = 'http://xxx'

# User settings in the develop container
# Set the value of $ whoami on the host
USERNAME = developer
# Set the value of $ id -u on the host
USER_UID = 1000
# Set the value of $ id -g on the host
USER_GID = 1000

#### Micro frontend environment variables
# Title string of the header (optional)
NEXT_PUBLIC_HEADER_TITLE = 'Composable Disaggregated Infrastructure Manager'

# Micro frontend URL settings
NEXT_PUBLIC_URL_CORE      = 'http://localhost:3000'
NEXT_PUBLIC_URL_RESOURCE  = 'http://localhost:3003'
NEXT_PUBLIC_URL_LAYOUT    = 'http://localhost:3004'
NEXT_PUBLIC_URL_USER      = 'http://localhost:3005'

# URL of the authentication server
NEXT_PUBLIC_URL_IDP        = 'http://localhost:8287'
# Realm name
NEXT_PUBLIC_IDP_REALMS     = 'CDIM'
# Client ID for authentication
NEXT_PUBLIC_AUTH_CLIENT_ID = 'cdim-client'

# API endpoint of the configuration design backend
NEXT_PUBLIC_URL_BE_LAYOUT_DESIGN = 'http://localhost:8014/cdim/api/v1/layout-design'
# API endpoint of the configuration apply backend
NEXT_PUBLIC_URL_BE_LAYOUT_APPLY = 'http://localhost:8014/cdim/api/v1/layout-apply'
# API endpoint of the constraint management backend
NEXT_PUBLIC_URL_BE_POLICY_MANAGER = 'http://localhost:8014/cdim/api/v1/policy-manager'
# API endpoint of the configuration information management backend
NEXT_PUBLIC_URL_BE_CONFIGURATION_MANAGER = 'http://localhost:8014/cdim/api/v1/configuration-manager'
# API endpoint of the performance information management backend (VictoriaMetrics)
NEXT_PUBLIC_URL_BE_PERFORMANCE_MANAGER = 'http://localhost:8014/cdim/api/v1/performance-manager'

# Flag for displaying or hiding the menu for Resource Management
NEXT_PUBLIC_DISPLAY_MENU_RES_SUMMARY = 'true'
NEXT_PUBLIC_DISPLAY_MENU_RES_RESOURCE_GROUPS = 'true'
NEXT_PUBLIC_DISPLAY_MENU_RES_CXL_SWITCHES = 'true'
NEXT_PUBLIC_DISPLAY_MENU_RES_NODES = 'true'
NEXT_PUBLIC_DISPLAY_MENU_RES_RESOURCES = 'true'

# Flag for displaying or hiding the menu for Layout Management
NEXT_PUBLIC_DISPLAY_MENU_LAY_LAYOUT_APPLIES = 'true'

# Flag for displaying or hiding the menu for User Management
NEXT_PUBLIC_DISPLAY_MENU_USER_USERS = 'true'
